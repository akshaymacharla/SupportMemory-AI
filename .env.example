# ============================================================
# SupportMemory AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- Hindsight ----
# URL where your Hindsight server is running
HINDSIGHT_BASE_URL=http://localhost:8888

# The memory bank ID used for this application
HINDSIGHT_BANK_ID=support-memory-ai

# ---- LLM (Groq) ----
# Your Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model to use (llama-3.3-70b-versatile recommended)
GROQ_MODEL=llama-3.3-70b-versatile

# ---- MySQL Database ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=supportmemory
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# ---- Hindsight Docker (for internal LLM used by Hindsight) ----
# Hindsight needs its own LLM for internal fact extraction & graph resolution
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=sk-your_openai_key_here

